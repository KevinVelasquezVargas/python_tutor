msgstr "adding"

#: addon\globalPlugins\python_tutor\translator.py:109
msgid "restándole"
msgstr "subtracting"

#: addon\globalPlugins\python_tutor\translator.py:109
msgid "multiplicándolo por"
msgstr "multiplying it by"

#: addon\globalPlugins\python_tutor\translator.py:110
msgid "dividiéndolo entre"
msgstr "dividing it by"

#: addon\globalPlugins\python_tutor\translator.py:110
msgid "haciendo división entera con"
msgstr "floor dividing it by"

#: addon\globalPlugins\python_tutor\translator.py:114
msgid "aplicándole"
msgstr "applying"

#: addon\globalPlugins\python_tutor\translator.py:113
#, python-brace-format
msgid ""
"Actualización acumulativa: Modifica la variable '{var}' {operacion} {val}."
msgstr "Augmented assignment: Updates the variable '{var}' by {operacion} {val}."

#: addon\globalPlugins\python_tutor\translator.py:124
#, python-brace-format
msgid ""
"Asignación con entrada de usuario: Pide al usuario que escriba un dato y lo "
"guarda en la variable '{var}'."
msgstr "User input assignment: Prompts the user to type a value and stores it in the variable '{var}'."

#: addon\globalPlugins\python_tutor\translator.py:126
#, python-brace-format
msgid "Asignación de variable: Guarda en la variable '{var}' el texto {val}."
msgstr "Variable assignment: Stores the text {val} in the variable '{var}'."

#: addon\globalPlugins\python_tutor\translator.py:128
#, python-brace-format
msgid ""
"Asignación de variable: Guarda en la variable '{var}' el número entero {val}."
msgstr "Variable assignment: Stores the integer {val} in the variable '{var}'."

#: addon\globalPlugins\python_tutor\translator.py:130
#, python-brace-format
msgid ""
"Asignación de variable: Guarda en la variable '{var}' el valor lógico {val}."
msgstr "Variable assignment: Stores the boolean value {val} in the variable '{var}'."

#: addon\globalPlugins\python_tutor\translator.py:132
#, python-brace-format
msgid ""
"Asignación de variable: Crea una lista de elementos y la almacena en '{var}'."
msgstr "Variable assignment: Creates a list of elements and stores it in '{var}'."

#: addon\globalPlugins\python_tutor\translator.py:134
#, python-brace-format
msgid ""
"Asignación de variable: Evalúa '{val}' y guarda el resultado en la variable "
"'{var}'."
msgstr "Variable assignment: Evaluates '{val}' and stores the result in the variable '{var}'."

#: addon\globalPlugins\python_tutor\translator.py:138
msgid ""
"Bloque vigilado (try): Inicia una sección donde intentará ejecutar código "
"protegiéndolo de posibles errores."
msgstr "'Try' block: Starts a section where code is attempted while guarding against possible errors."

#: addon\globalPlugins\python_tutor\translator.py:144
#, python-brace-format
msgid ""
"Captura de error (except): Si en el bloque try ocurre un fallo de tipo "
"'{err}', ejecutará estas instrucciones para solucionarlo."
msgstr "'Except' block: If a failure of type '{err}' occurs in the try block, it will run these instructions to handle it."

#: addon\globalPlugins\python_tutor\translator.py:145
msgid ""
"Captura de error (except): Si en el bloque anterior ocurre cualquier error, "
"ejecutará este bloque de contingencia."
msgstr "'Except' block: If any error occurs in the previous block, it will run this contingency block."

#: addon\globalPlugins\python_tutor\translator.py:151
#, python-brace-format
msgid ""
"Importación de módulo: Carga la librería '{modulo}' para utilizar sus "
"funciones adicionales."
msgstr "'Import' statement: Loads the library '{modulo}' to use its additional functions."

#: addon\globalPlugins\python_tutor\translator.py:157
#, python-brace-format
msgid "Importación específica: Carga '{nombres}' desde el módulo '{origen}'."
msgstr "'Import from' statement: Loads '{nombres}' from the module '{origen}'."

#: addon\globalPlugins\python_tutor\translator.py:164
#, python-brace-format
msgid ""
"Método append: Agrega el elemento '{item}' al final de la lista '{lista}'."
msgstr "append method: Appends the element '{item}' to the end of the list '{lista}'."

#: addon\globalPlugins\python_tutor\translator.py:172
#, python-brace-format
msgid ""
"Método remove: Elimina la primera aparición de '{item}' en la lista "
"'{lista}'."
msgstr "remove method: Removes the first occurrence of '{item}' in the list '{lista}'."

#: addon\globalPlugins\python_tutor\translator.py:178
msgid "Sentencia break: Interrumpe y finaliza inmediatamente el bucle actual."
msgstr "'Break' statement: Interrupts and immediately terminates the current loop."

#: addon\globalPlugins\python_tutor\translator.py:180
msgid ""
"Sentencia continue: Salta directamente a la siguiente vuelta del bucle "
"ignorando el resto del bloque."
msgstr "'Continue' statement: Jumps directly to the next iteration of the loop, ignoring the rest of the block."

#: addon\globalPlugins\python_tutor\translator.py:182
msgid ""
"Sentencia pass: Indicador de paso nulo (no realiza ninguna acción, reserva "
"el espacio de un bloque)."
msgstr "'Pass' statement: Null placeholder (it performs no action; it reserves the space of a block)."

