#. Translators: Dialog title for text search.

#: addon\globalPlugins\python_tutor\gui_frame.py:64
msgid "Find in Editor"
msgstr "Buscar en el Editor"

#. Translators: Label for search query text field.

#: addon\globalPlugins\python_tutor\gui_frame.py:71
msgid "Text to &find:"
msgstr "Texto a &buscar:"

#. Translators: Checkbox label for case-sensitive search.

#: addon\globalPlugins\python_tutor\gui_frame.py:79
msgid "Match &case"
msgstr "Coincidir &mayúsculas y minúsculas"

#. Translators: Button to find next occurrence.

#: addon\globalPlugins\python_tutor\gui_frame.py:84
msgid "&Find Next"
msgstr "&Buscar siguiente"

#. Translators: Button to close search dialog.

#: addon\globalPlugins\python_tutor\gui_frame.py:87
msgid "&Close"
msgstr "&Cerrar"

#. Translators: Speech announcement when user submits empty search field.

#: addon\globalPlugins\python_tutor\gui_frame.py:109
msgid "Enter text to search."
msgstr "Escribe un texto para buscar."

#. Translators: Speech notification when search query is found.

#: addon\globalPlugins\python_tutor\gui_frame.py:127

#, python-brace-format
msgid "Found '{query}' on line {line}"
msgstr "Encontrado '{query}' en la línea {line}"

#. Translators: Speech notification when search query is not found.

#: addon\globalPlugins\python_tutor\gui_frame.py:135

#, python-brace-format
msgid "'{query}' not found in code."
msgstr "No se encontró '{query}' en el código."

#. Translators: Dialog title for jump to line number.

#: addon\globalPlugins\python_tutor\gui_frame.py:146
msgid "Go to Line"
msgstr "Ir a la Línea"

#. Translators: Label indicating available line number range.

#: addon\globalPlugins\python_tutor\gui_frame.py:158

#, python-brace-format
msgid "&Line number (1 - {total}):"
msgstr "&Número de línea (1 - {total}):"

#. Translators: Button to execute line jump.

#: addon\globalPlugins\python_tutor\gui_frame.py:167
msgid "&Go to Line"
msgstr "&Ir a línea"

#. Translators: Button to cancel line jump dialog.

#: addon\globalPlugins\python_tutor\gui_frame.py:170

#: addon\globalPlugins\python_tutor\gui_frame.py:257

#: addon\globalPlugins\python_tutor\gui_frame.py:582
msgid "&Cancel"
msgstr "&Cancelar"

#. Translators: Speech announcement for invalid line number entry.

#: addon\globalPlugins\python_tutor\gui_frame.py:194
msgid "Please enter a valid line number."
msgstr "Por favor introduce un número de línea válido."

#. Translators: Speech notification confirming cursor positioned at line.

#: addon\globalPlugins\python_tutor\gui_frame.py:204

#, python-brace-format
msgid "Cursor on line {line}"
msgstr "Cursor en línea {line}"

#. Translators: Speech error announcement when line number is out of bounds.

#: addon\globalPlugins\python_tutor\gui_frame.py:213

#, python-brace-format
msgid "The line must be between 1 and {total}."
msgstr "La línea debe estar entre 1 y {total}."

#. Translators: Dialog title for selecting curriculum chapters.

#: addon\globalPlugins\python_tutor\gui_frame.py:220
msgid "Curriculum Chapter Selector"
msgstr "Selector de Capítulos del Temario"

#. Translators: Label for chapter selection list.

#: addon\globalPlugins\python_tutor\gui_frame.py:225
msgid "Choose the &chapter you want to access:"
msgstr "Elige el &capítulo al que deseas acceder:"

#. Translators: Status prefix for completed chapter.

#: addon\globalPlugins\python_tutor\gui_frame.py:237
msgid "Completed, "
msgstr "Superado, "

#. Translators: Status prefix for available chapter.

#: addon\globalPlugins\python_tutor\gui_frame.py:240
msgid "Available, "
msgstr "Disponible, "

#. Translators: Status prefix for locked chapter.

#: addon\globalPlugins\python_tutor\gui_frame.py:243
msgid "Locked, "
msgstr "Bloqueado, "

#. Translators: Accessible name for chapter selection list.

#: addon\globalPlugins\python_tutor\gui_frame.py:248
msgid "Chapter list. Press Enter or click to select."
msgstr "Lista de capítulos. Presione Enter o haga clic para seleccionar."

#. Translators: Button to load chosen chapter.

#: addon\globalPlugins\python_tutor\gui_frame.py:255
msgid "&Load Chapter"
msgstr "&Cargar Capítulo"

#. Translators: Message explaining a chapter is locked.

#: addon\globalPlugins\python_tutor\gui_frame.py:281
msgid ""
"This chapter is locked. You must complete all steps of the previous chapter "
"to unlock it."
msgstr ""

#. Translators: Message box title when chapter is locked.

#: addon\globalPlugins\python_tutor\gui_frame.py:285
msgid "Chapter Locked"
msgstr "Capítulo bloqueado"

#. Translators: Title for pedagogical assistance hint dialog.

#: addon\globalPlugins\python_tutor\gui_frame.py:297
msgid "Assistance Hint"
msgstr "Pista de Asistencia"

#. Translators: Label indicating current hint tier level.

#: addon\globalPlugins\python_tutor\gui_frame.py:303

#, python-brace-format
msgid "Available hint (Level {level} of {total}):"
msgstr "Pista disponible (Nivel {level} de {total}):"

#. Translators: Fallback message when no hint text is defined.

#: addon\globalPlugins\python_tutor\gui_frame.py:307
msgid "Review the exercise instructions."
msgstr "Revisa las instrucciones del ejercicio."

#. Translators: Accessible name for hint text box.

#: addon\globalPlugins\python_tutor\gui_frame.py:312
msgid "Hint content."
msgstr "Contenido de la pista."

#. Translators: Confirmation button to dismiss hint.

#: addon\globalPlugins\python_tutor\gui_frame.py:316
msgid "&Understood"
msgstr "&Entendido"

#. Translators: Title for the first-launch welcome dialog.

#: addon\globalPlugins\python_tutor\gui_frame.py:335
msgid "Welcome to Python Learning with NVDA"
msgstr "Bienvenido a Aprendizaje de Python con NVDA"

#. Translators: Accessible name for welcome text control.

#: addon\globalPlugins\python_tutor\gui_frame.py:355
msgid "Welcome message"
msgstr "Mensaje de bienvenida"

#. Translators: Checkbox to show welcome dialog on start.

#: addon\globalPlugins\python_tutor\gui_frame.py:360
msgid "&Show this welcome guide on startup"
msgstr "&Mostrar esta guía de bienvenida al iniciar"

#. Translators: Primary button to start learning curriculum.

#: addon\globalPlugins\python_tutor\gui_frame.py:365
msgid "&Start learning"
msgstr "&Comenzar a aprender"

#. Translators: Dialog title for keyboard shortcuts guide.

#: addon\globalPlugins\python_tutor\gui_frame.py:389
msgid "Keyboard Shortcuts Guide"
msgstr "Guía de Atajos de Teclado"

#. Translators: Accessible name for keyboard shortcuts text box.

#: addon\globalPlugins\python_tutor\gui_frame.py:447
msgid "Full list of keyboard shortcuts"
msgstr "Lista completa de atajos de teclado"

#. Translators: Button to close shortcuts guide.

#: addon\globalPlugins\python_tutor\gui_frame.py:451
msgid "&Close Guide"
msgstr "&Cerrar Guía"

#. Translators: Dialog title for Python terms glossary.

#: addon\globalPlugins\python_tutor\gui_frame.py:471
msgid "Python Terms Dictionary"
msgstr "Diccionario de Términos de Python"

#. Translators: Label for glossary search input.

#: addon\globalPlugins\python_tutor\gui_frame.py:480
msgid "Search &term:"
msgstr "Buscar &término:"

#. Translators: Accessible name for glossary search control.

#: addon\globalPlugins\python_tutor\gui_frame.py:484
msgid "Type command or concept here to search."
msgstr "Escribe aquí el comando o concepto para buscar."

#. Translators: Accessible name for available glossary terms list.

#: addon\globalPlugins\python_tutor\gui_frame.py:491
msgid "Available terms."
msgstr "Términos disponibles."

#. Translators: Accessible name for term definition readout.

#: addon\globalPlugins\python_tutor\gui_frame.py:496
msgid "Meaning of the term."
msgstr "Significado del término."

#. Translators: Button to close glossary dictionary.

#: addon\globalPlugins\python_tutor\gui_frame.py:501
msgid "&Close Dictionary"
msgstr "&Cerrar Diccionario"

#. Translators: Notice displayed when glossary search finds no matches.

#: addon\globalPlugins\python_tutor\gui_frame.py:532
msgid "No matches found."
msgstr "No se encontraron coincidencias."

#. Translators: Dialog title for symbols navigation.

#: addon\globalPlugins\python_tutor\gui_frame.py:546
msgid "Code Structure: Functions and Classes"
msgstr "Estructura del Código: Funciones y Clases"

#. Translators: Label identifying symbol as Class or Function.

#: addon\globalPlugins\python_tutor\gui_frame.py:557
msgid "Class"
msgstr "Clase"

#: addon\globalPlugins\python_tutor\gui_frame.py:557
msgid "Function"
msgstr "Función"

#. Translators: Label for symbols selector list.

#: addon\globalPlugins\python_tutor\gui_frame.py:563
msgid "Select a &function or class to jump cursor directly to its header:"
msgstr "Selecciona una &función o clase para desplazar el cursor directamente a su cabecera:"

#. Translators: Notice in symbols list when no definitions are present.

#: addon\globalPlugins\python_tutor\gui_frame.py:569
msgid "(No functions or classes found in current code)"
msgstr "(No se encontraron funciones ni clases en el código actual)"

#. Translators: Accessible name for symbols list box.

#: addon\globalPlugins\python_tutor\gui_frame.py:573
msgid "List of functions and classes. Press Enter to jump to element."
msgstr "Lista de funciones y clases. Presione Enter para ir al elemento."

#. Translators: Button to jump to selected symbol.

#: addon\globalPlugins\python_tutor\gui_frame.py:580
msgid "&Go to Element"
msgstr "&Ir al elemento"

#. Translators: Dialog title for technical support and contact.

#: addon\globalPlugins\python_tutor\gui_frame.py:611
msgid "Support and Contact"
msgstr "Soporte y Contacto"

#. Translators: Accessible name for support info text control.

#: addon\globalPlugins\python_tutor\gui_frame.py:629
msgid "Support and contact information"
msgstr "Información de soporte y contacto"

#. Translators: Button to open default mail client for support.

#: addon\globalPlugins\python_tutor\gui_frame.py:634
msgid "&Send support email"
msgstr "&Enviar correo de soporte"

#. Translators: Button to open donation page.

#: addon\globalPlugins\python_tutor\gui_frame.py:636
msgid "Make &donation (PayPal)"
msgstr "Realizar &donación (PayPal)"

#. Translators: Speech announcement when opening email client.

#: addon\globalPlugins\python_tutor\gui_frame.py:663
msgid "Opening default email client..."
msgstr "Abriendo cliente de correo predeterminado..."

#. Translators: Speech announcement displaying contact email address.

#: addon\globalPlugins\python_tutor\gui_frame.py:667

#, python-brace-format
msgid "Write to {email}"
msgstr "Escribe a {email}"

#. Translators: Speech announcement when opening donations link.

#: addon\globalPlugins\python_tutor\gui_frame.py:675
msgid "Opening donations page..."
msgstr "Abriendo página de donaciones..."

#. Translators: Dialog title for About documentation.

#: addon\globalPlugins\python_tutor\gui_frame.py:684
msgid "About Python Learning with NVDA"
msgstr "Acerca de Aprendizaje de Python con NVDA"

#. Translators: Accessible name for about documentation text control.

#: addon\globalPlugins\python_tutor\gui_frame.py:841
msgid "Python Learning with NVDA Documentation"
msgstr "Documentación de Aprendizaje de Python con NVDA"

#. Translators: Main application window title.

#: addon\globalPlugins\python_tutor\gui_frame.py:873
msgid "Python Learning with NVDA"
msgstr "Aprendizaje de Python con NVDA"

#. Translators: Accessible name for active step instruction control.

#: addon\globalPlugins\python_tutor\gui_frame.py:907
msgid "Active step instruction."
msgstr "Instrucción del paso activo."

#. 3. Editor de código

#. Translators: Label for the code editor area.

#: addon\globalPlugins\python_tutor\gui_frame.py:912
msgid "Code editor:"
msgstr "Editor de código:"

#. Translators: Accessible name for the code editor text control.

#: addon\globalPlugins\python_tutor\gui_frame.py:917
msgid "Code editor"
msgstr "Editor de código"

#. 4. Consola de resultados

#. Translators: Label for results output and diagnostic console.

#: addon\globalPlugins\python_tutor\gui_frame.py:922
msgid "Results and diagnostic console:"
msgstr "Consola de resultados y diagnóstico:"

#. Translators: Accessible name for the results output console control.

#: addon\globalPlugins\python_tutor\gui_frame.py:927
msgid "Results console."
msgstr "Consola de resultados."

#. Translators: Toolbar button to run script or check exercise.

#: addon\globalPlugins\python_tutor\gui_frame.py:934
msgid "&Run (F5 or Ctrl+Enter)"
msgstr "&Ejecutar (F5 o Ctrl+Enter)"

#. Translators: Accessible name for run code button.

#: addon\globalPlugins\python_tutor\gui_frame.py:936
msgid "Run Code Button"
msgstr "Botón Ejecutar Código"

#. Translators: Toolbar button to request hint.

#: addon\globalPlugins\python_tutor\gui_frame.py:939
msgid "Get &Hint (Ctrl+P)"
msgstr "Pedir &pista (Ctrl+P)"

#. Translators: Accessible name for hint button.

#: addon\globalPlugins\python_tutor\gui_frame.py:941
msgid "Get Hint Button"
msgstr "Botón Pedir Pista"

#. Translators: Toolbar button to explain current code line.

#: addon\globalPlugins\python_tutor\gui_frame.py:944
msgid "Explain &Line (F1)"
msgstr "Explicar &línea (F1)"

#. Translators: Accessible name for explain line button.

#: addon\globalPlugins\python_tutor\gui_frame.py:946
msgid "Explain Line Button"
msgstr "Botón Explicar Línea"

#. Translators: Toolbar button to go to previous step.

#: addon\globalPlugins\python_tutor\gui_frame.py:949
msgid "&Previous Step (Alt+Left)"
msgstr "Paso &anterior (Alt+Izquierda)"

#. Translators: Accessible name for previous step button.

#: addon\globalPlugins\python_tutor\gui_frame.py:951
msgid "Previous Step Button"
msgstr "Botón Paso Anterior"

#. Translators: Toolbar button to go to next step.

#: addon\globalPlugins\python_tutor\gui_frame.py:954
msgid "&Next Step (Alt+Right)"
msgstr "Paso &siguiente (Alt+Derecha)"

#. Translators: Accessible name for next step button.

#: addon\globalPlugins\python_tutor\gui_frame.py:956
msgid "Next Step Button"
msgstr "Botón Paso Siguiente"

#. Translators: Toolbar button to open curriculum chapter selector.

#: addon\globalPlugins\python_tutor\gui_frame.py:959
msgid "&Curriculum (Ctrl+1)"
msgstr "&Temario (Ctrl+1)"

#. Translators: Accessible name for chapter selector button.

#: addon\globalPlugins\python_tutor\gui_frame.py:961
msgid "Chapter Selector Button"
msgstr "Botón Selector de Capítulos"

#. Translators: Toolbar button to close application.

#: addon\globalPlugins\python_tutor\gui_frame.py:964
msgid "&Close (Escape)"
msgstr "&Cerrar (Escape)"

#. Translators: Accessible name for close button.

#: addon\globalPlugins\python_tutor\gui_frame.py:966
msgid "Close Button"
msgstr "Botón Cerrar"

#: addon\globalPlugins\python_tutor\gui_frame.py:1043
msgid "&New script\tCtrl+N"
msgstr "Nuevo script	Ctrl+N"

#: addon\globalPlugins\python_tutor\gui_frame.py:1043
msgid "Starts a new blank script in the editor"
msgstr "Inicia un nuevo script limpio en el editor"

#: addon\globalPlugins\python_tutor\gui_frame.py:1044
msgid "&Open file...\tCtrl+O"
msgstr "Abrir archivo...	Ctrl+O"

#: addon\globalPlugins\python_tutor\gui_frame.py:1044
msgid "Loads a Python script from disk"
msgstr "Carga un script de Python desde el disco"

#: addon\globalPlugins\python_tutor\gui_frame.py:1045
msgid "&Save script\tCtrl+S"
msgstr "Guardar script	Ctrl+S"

#: addon\globalPlugins\python_tutor\gui_frame.py:1045
msgid "Saves editor content to file"
msgstr "Guarda el contenido del editor en el archivo"

#: addon\globalPlugins\python_tutor\gui_frame.py:1046
msgid "Save &as...\tCtrl+Shift+S"
msgstr "Guardar como...	Ctrl+Shift+S"

#: addon\globalPlugins\python_tutor\gui_frame.py:1046
msgid "Saves code with a new name or location"
msgstr "Guarda el código con un nuevo nombre o ubicación"

#: addon\globalPlugins\python_tutor\gui_frame.py:1048
msgid "&Close tutor\tAlt+F4"
msgstr "Cerrar tutor	Alt+F4"

#: addon\globalPlugins\python_tutor\gui_frame.py:1048
msgid "Closes the learning environment"
msgstr "Cierra el entorno de aprendizaje"

#: addon\globalPlugins\python_tutor\gui_frame.py:1058
msgid "&Undo\tCtrl+Z"
msgstr "Deshacer	Ctrl+Z"

#: addon\globalPlugins\python_tutor\gui_frame.py:1058
msgid "Reverts the last editing action"
msgstr "Revierte la última acción de edición"

#: addon\globalPlugins\python_tutor\gui_frame.py:1059
msgid "&Redo\tCtrl+Y"
msgstr "Rehacer	Ctrl+Y"

#: addon\globalPlugins\python_tutor\gui_frame.py:1059
msgid "Reapplies undone action"
msgstr "Reaplica la acción deshecha"

#: addon\globalPlugins\python_tutor\gui_frame.py:1061
msgid "Cu&t\tCtrl+X"
msgstr "Cortar	Ctrl+X"

#: addon\globalPlugins\python_tutor\gui_frame.py:1061
msgid "Cuts selected text to clipboard"
msgstr "Corta el texto seleccionado al portapapeles"

#: addon\globalPlugins\python_tutor\gui_frame.py:1062
msgid "&Copy\tCtrl+C"
msgstr "Copiar	Ctrl+C"

#: addon\globalPlugins\python_tutor\gui_frame.py:1062
msgid "Copies selected text to clipboard"
msgstr "Copia el texto seleccionado al portapapeles"

#: addon\globalPlugins\python_tutor\gui_frame.py:1063
msgid "&Paste\tCtrl+V"
msgstr "Pegar	Ctrl+V"

#: addon\globalPlugins\python_tutor\gui_frame.py:1063
msgid "Pastes clipboard content"
msgstr "Pega el contenido del portapapeles"

#: addon\globalPlugins\python_tutor\gui_frame.py:1064
msgid "Select &all\tCtrl+A"
msgstr "Seleccionar todo	Ctrl+A"

#: addon\globalPlugins\python_tutor\gui_frame.py:1064
msgid "Selects all text in editor"
msgstr "Selecciona todo el texto del editor"

#: addon\globalPlugins\python_tutor\gui_frame.py:1066
msgid "&Find text...\tCtrl+F"
msgstr "Buscar texto...	Ctrl+F"

#: addon\globalPlugins\python_tutor\gui_frame.py:1066
msgid "Searches for words or code snippets"
msgstr "Busca palabras o fragmentos de código"

#: addon\globalPlugins\python_tutor\gui_frame.py:1067
msgid "&Go to line...\tCtrl+G"
msgstr "Ir a línea...	Ctrl+G"

#: addon\globalPlugins\python_tutor\gui_frame.py:1067
msgid "Moves cursor to specified line number"
msgstr "Desplaza el cursor al número de línea indicado"

#: addon\globalPlugins\python_tutor\gui_frame.py:1069
msgid "Format document by &PEP 8\tShift+Alt+F"
msgstr "Formatear documento según PEP 8	Shift+Alt+F"

#: addon\globalPlugins\python_tutor\gui_frame.py:1069
msgid "Adjusts indentation to 4 spaces and formats operator spacing"
msgstr "Ajusta la sangría a 4 espacios y los espacios de operadores"

#: addon\globalPlugins\python_tutor\gui_frame.py:1070
msgid "&Rename symbol...\tF2"
msgstr "Renombrar símbolo...	F2"

#: addon\globalPlugins\python_tutor\gui_frame.py:1070
msgid "Renames selected variable or function across script"
msgstr "Renombra la variable o función seleccionada en todo el script"

#: addon\globalPlugins\python_tutor\gui_frame.py:1071
msgid "E&xtract to function...\tCtrl+Shift+R"
msgstr "Extraer a función...	Ctrl+Shift+R"

#: addon\globalPlugins\python_tutor\gui_frame.py:1071
msgid "Converts selected block into a new function"
msgstr "Convierte el bloque seleccionado en una nueva función"

#: addon\globalPlugins\python_tutor\gui_frame.py:1073
msgid "List of &functions and classes...\tCtrl+Shift+O"
msgstr "Lista de funciones y clases...	Ctrl+Shift+O"

#: addon\globalPlugins\python_tutor\gui_frame.py:1073
msgid "Opens list of functions and classes in file"
msgstr "Abre la lista de funciones y clases del archivo"

#: addon\globalPlugins\python_tutor\gui_frame.py:1074
msgid "&Next function or class\tAlt+N"
msgstr "Ir a siguiente función o clase	Alt+N"

#: addon\globalPlugins\python_tutor\gui_frame.py:1074
msgid "Jumps to next function or class header"
msgstr "Salta a la cabecera de la siguiente función o clase"

#: addon\globalPlugins\python_tutor\gui_frame.py:1075
msgid "&Previous function or class\tAlt+P"
msgstr "Ir a anterior función o clase	Alt+P"

#: addon\globalPlugins\python_tutor\gui_frame.py:1075
msgid "Jumps to previous function or class header"
msgstr "Salta a la cabecera de la función o clase anterior"

#: addon\globalPlugins\python_tutor\gui_frame.py:1077
msgid "Toggle &comment on line\tCtrl+/"
msgstr "Comentar o descomentar línea	Ctrl+/"

#: addon\globalPlugins\python_tutor\gui_frame.py:1077
msgid "Toggles '#' comment prefix on current line"
msgstr "Alterna el comentario '#' al inicio de la línea"

#: addon\globalPlugins\python_tutor\gui_frame.py:1078
msgid "&Duplicate line below\tCtrl+D"
msgstr "Duplicar línea abajo	Ctrl+D"

#: addon\globalPlugins\python_tutor\gui_frame.py:1078
msgid "Duplicates current line below"
msgstr "Duplica la línea actual en la siguiente"

#: addon\globalPlugins\python_tutor\gui_frame.py:1079
msgid "D&elete current line\tCtrl+Shift+K"
msgstr "Eliminar línea actual	Ctrl+Shift+K"

#: addon\globalPlugins\python_tutor\gui_frame.py:1079
msgid "Completely deletes the line at cursor"
msgstr "Elimina por completo la línea donde está el cursor"

#: addon\globalPlugins\python_tutor\gui_frame.py:1081
msgid "Check s&yntax and delimiters\tF7"
msgstr "Verificar sintaxis y delimitadores	F7"

#: addon\globalPlugins\python_tutor\gui_frame.py:1081
msgid "Checks parentheses, quotes, and syntax errors"
msgstr "Comprueba paréntesis, comillas y errores de sintaxis"

#: addon\globalPlugins\python_tutor\gui_frame.py:1082
msgid "Announce &position (Line and column)\tCtrl+L"
msgstr "Anunciar posición (Línea y columna)	Ctrl+L"

#: addon\globalPlugins\python_tutor\gui_frame.py:1082
msgid "Reports line and column cursor position"
msgstr "Informa en qué línea y columna se encuentra el cursor"

#: addon\globalPlugins\python_tutor\gui_frame.py:1106
msgid "Toggle &focus between editor and console\tF6"
msgstr "Alternar foco entre editor y consola	F6"

#: addon\globalPlugins\python_tutor\gui_frame.py:1106
msgid "Switches focus between editor and output"
msgstr "Cambia el foco entre el editor de código y la salida"

#: addon\globalPlugins\python_tutor\gui_frame.py:1107
msgid "Toggle &Learning / Standalone Mode\tCtrl+M"
msgstr "Alternar Modo Aprendizaje / Editor autónomo	Ctrl+M"

#: addon\globalPlugins\python_tutor\gui_frame.py:1107
msgid "Toggles between didactic guide and standalone editor"
msgstr "Conmuta entre el entorno didáctico y el editor limpio"

#: addon\globalPlugins\python_tutor\gui_frame.py:1108
msgid "Toggle &breakpoint\tF9"
msgstr "Alternar punto de interrupción	F9"

#: addon\globalPlugins\python_tutor\gui_frame.py:1108
msgid "Toggles a breakpoint on current line"
