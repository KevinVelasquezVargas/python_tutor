#: addon\globalPlugins\python_tutor\translator.py:29
#, python-brace-format
msgid ""
"Comentario: {comentario}. Las computadoras ignoran esta línea, sirve como "
"nota explicativa."
msgstr "Comment: {comentario}. Computers ignore this line, it serves as an explanatory note."

#: addon\globalPlugins\python_tutor\translator.py:43
msgid "Instrucción print: Imprime una línea en blanco en la salida de consola."
msgstr "Print statement: Outputs a blank line to console."

#: addon\globalPlugins\python_tutor\translator.py:46
#, python-brace-format
msgid ""
"Instrucción print: Muestra en pantalla y lee con voz el mensaje: '{texto}'."
msgstr "Print statement: Displays on screen and speaks aloud: '{texto}'."

#: addon\globalPlugins\python_tutor\translator.py:48
#, python-brace-format
msgid ""
"Instrucción print: Muestra varios datos en pantalla separados por espacios: "
"{contenido}."
msgstr "Print statement: Displays multiple values separated by spaces: {contenido}."

#: addon\globalPlugins\python_tutor\translator.py:50
#, python-brace-format
msgid ""
"Instrucción print: Calcula la operación matemática '{contenido}' y muestra "
"el resultado."
msgstr "Print statement: Calculates mathematical expression '{contenido}' and outputs the result."

#: addon\globalPlugins\python_tutor\translator.py:52
#, python-brace-format
msgid ""
"Instrucción print: Muestra el valor contenido en la variable o expresión: "
"{contenido}."
msgstr "Print statement: Displays the value stored in variable or expression: {contenido}."

#: addon\globalPlugins\python_tutor\translator.py:58
#, python-brace-format
msgid ""
"Condicional 'si' (if): Comprueba si se cumple '{cond}'. Si es verdadera, "
"ejecutará las instrucciones indentadas siguientes."
msgstr "Conditional 'if': Checks whether '{cond}' evaluates to true. If so, it will execute the following indented instructions."

#: addon\globalPlugins\python_tutor\translator.py:64
#, python-brace-format
msgid ""
"Condición alternativa (elif): Si la condición anterior fue falsa pero "
"'{cond}' es verdadera, ejecutará este bloque."
msgstr "Alternative condition 'elif': If the previous condition was false but '{cond}' is true, it will execute this block."

#: addon\globalPlugins\python_tutor\translator.py:68
msgid ""
"Caso alternativo 'de lo contrario' (else): Se ejecutará si ninguna de las "
"condiciones anteriores resultó verdadera."
msgstr "Default branch 'else': Runs when none of the preceding conditions were true."

#: addon\globalPlugins\python_tutor\translator.py:75
#, python-brace-format
msgid ""
"Bucle 'para cada' (for): Recorrerá uno a uno los elementos de '{iterable}', "
"asignando cada uno a la variable '{var}' en cada vuelta."
msgstr "'For' loop: Iterates through each item in '{iterable}', assigning each one to the variable '{var}' on every pass."

#: addon\globalPlugins\python_tutor\translator.py:81
#, python-brace-format
msgid ""
"Bucle 'mientras' (while): Repetirá las instrucciones siguientes de forma "
"continua mientras la condición '{cond}' siga siendo verdadera."
msgstr "'While' loop: Repeats the following instructions continuously for as long as the condition '{cond}' remains true."

#: addon\globalPlugins\python_tutor\translator.py:89
#, python-brace-format
msgid "con los parámetros '{params}'"
msgstr "with parameters '{params}'"

#: addon\globalPlugins\python_tutor\translator.py:91
msgid "sin recibir parámetros"
msgstr "without taking any parameters"

#: addon\globalPlugins\python_tutor\translator.py:92
#, python-brace-format
msgid ""
"Definición de función: Crea una nueva función llamada '{nombre}' {p_desc}."
msgstr "Function definition (def): Creates a new function named '{nombre}' {p_desc}."

#: addon\globalPlugins\python_tutor\translator.py:99
#, python-brace-format
msgid ""
"Retorno de función: Finaliza la ejecución de la función y devuelve el "
"resultado: {val}."
msgstr "'Return' statement: Ends the function's execution and returns the result: {val}."

#: addon\globalPlugins\python_tutor\translator.py:100
msgid ""
"Retorno de función: Finaliza la ejecución de la función sin devolver ningún "
"valor específico."
msgstr "'Return' statement: Ends the function's execution without returning any specific value."

#: addon\globalPlugins\python_tutor\translator.py:109
